---
import { SITE, SOCIAL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="mono">© {year} {SITE.author}</p>
    <nav class="links">
      {SOCIAL.map((s) => (
        <a href={s.href} class="mono link" target="_blank" rel="noopener noreferrer">{s.label}</a>
      ))}
      <a href="/rss.xml" class="mono link">RSS</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line-soft);
    padding-block: 2.5rem;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .links { display: flex; gap: 1.2rem; }
  .link { color: var(--ink-faint); transition: color .2s var(--ease); }
  .link:hover { color: var(--accent); }
</style>
