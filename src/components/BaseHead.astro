---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** 글 페이지면 'article', 그 외는 'website'(기본) */
  type?: 'website' | 'article';
  /** 글의 발행일. article 일 때 og·JSON-LD 에 쓰인다. */
  publishedDate?: Date;
  updatedDate?: Date;
}
const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedDate,
  updatedDate,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

// 구조화 데이터: 글이면 BlogPosting, 그 외 홈/목록은 WebSite
const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      author: { '@type': 'Person', name: SITE.author },
      publisher: { '@type': 'Person', name: SITE.author },
      url: canonical.href,
      mainEntityOfPage: canonical.href,
      ...(publishedDate && { datePublished: publishedDate.toISOString() }),
      ...(updatedDate && { dateModified: updatedDate.toISOString() }),
      ...(ogImage && { image: ogImage.href }),
      inLanguage: SITE.lang,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.title,
      description: SITE.description,
      url: SITE.url,
      inLanguage: SITE.lang,
    };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Google Search Console 소유권 확인 -->
<meta name="google-site-verification" content="V2QzBo27KhDFak5Ra8tNfYrrKIJmWCA_cUtWb7kftT0" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="ko_KR" />
{ogImage && <meta property="og:image" content={ogImage} />}
{type === 'article' && publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{type === 'article' && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- 폰트: Fraunces(display) + JetBrains Mono(mono) + Pretendard(body, KR+EN) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
/>

<!-- 다크/라이트: 페인트 전에 테마 세팅해 깜빡임(FOUC) 방지 -->
<script is:inline>
  (() => {
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = stored ?? (prefersDark ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  })();
</script>
