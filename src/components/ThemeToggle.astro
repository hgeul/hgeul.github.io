---
// 라이트/다크 토글 버튼. 상태는 localStorage 에 저장.
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="테마 전환" title="테마 전환">
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px; height: 40px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper-card);
    color: var(--ink-soft);
    cursor: pointer;
    transition: border-color .2s var(--ease), color .2s var(--ease), transform .2s var(--ease);
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }
  .theme-toggle svg { position: absolute; transition: opacity .25s var(--ease), transform .35s var(--ease); }
  :root[data-theme='dark'] .sun { opacity: 0; transform: rotate(-40deg) scale(.6); }
  :root[data-theme='dark'] .moon { opacity: 1; transform: rotate(0) scale(1); }
  :root:not([data-theme='dark']) .moon { opacity: 0; transform: rotate(40deg) scale(.6); }
  :root:not([data-theme='dark']) .sun { opacity: 1; transform: rotate(0) scale(1); }
</style>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
