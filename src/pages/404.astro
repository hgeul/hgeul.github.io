---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <section class="container nf">
    <p class="mono code rise">404</p>
    <h1 class="rise" style="animation-delay:80ms">페이지를 찾을 수 없어요</h1>
    <p class="rise" style="animation-delay:160ms">주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <a href="/" class="btn rise" style="animation-delay:240ms">← 홈으로</a>
  </section>
</Base>

<style>
  .nf { min-height: 60vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 1rem; padding-block: 4rem; }
  .code { color: var(--accent); font-size: 1rem; letter-spacing: .3em; }
  .nf .btn { margin-top: 1rem; }
</style>
