---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recent = posts.slice(0, 6);
---

<Base>
  <section class="hero container">
    <h1 class="brand rise">{SITE.tagline}</h1>
    <p class="intro rise" style="animation-delay:100ms">
      {SITE.description}
    </p>
    <div class="cta rise" style="animation-delay:200ms">
      <a href="/blog" class="btn">글 전체 보기 →</a>
      <a href="/about" class="btn">소개</a>
    </div>
  </section>

  <section class="latest container">
    <div class="section-head">
      <h2>최근 글</h2>
      <a href="/blog" class="mono more">전체 {posts.length}편 →</a>
    </div>

    {recent.length === 0 ? (
      <p class="empty">아직 글이 없습니다. 첫 글을 준비 중이에요.</p>
    ) : (
      <div class="grid">
        {recent.map((post, i) => (
          <PostCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            index={i}
          />
        ))}
      </div>
    )}
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3.5rem, 10vw, 7rem) clamp(2.5rem, 6vw, 4rem); max-width: 900px; }
  .kicker { color: var(--accent); margin-bottom: 1.2rem; }
  .hero h1 { font-size: clamp(2.6rem, 8vw, 5rem); margin-bottom: 1.5rem; }
  .hero h1.brand { letter-spacing: -0.01em; line-height: 1.05; }
  .intro { font-size: 1.15rem; color: var(--ink-soft); max-width: 56ch; line-height: 1.65; }
  .cta { display: flex; gap: .7rem; margin-top: 2rem; flex-wrap: wrap; }

  .latest { padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3.5rem, 8vw, 6rem); }
  .section-head {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-bottom: 1.8rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .more { color: var(--ink-faint); transition: color .2s var(--ease); }
  .more:hover { color: var(--accent); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.1rem;
  }
  .empty { color: var(--ink-faint); padding: 2rem 0; }
</style>
